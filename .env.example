# Approved production public website origin. Keep HTTP until TLS is independently verified.
PUBLIC_SITE_URL=http://slgs.edu.sl

# Migration-only PostgreSQL connection. Runtime applications use their own credentials.
DATABASE_MIGRATION_URL=postgresql://slgs_migrator:replace-me@localhost:5432/slgs
PLATFORM_ADMIN_DATABASE_URL=postgresql://slgs_platform_admin:replace-me@localhost:5432/slgs
DATABASE_BOOTSTRAP_ADMIN_URL=postgresql://slgs_owner:replace-me@localhost:5432/slgs

# Application runtime connections must have different database grants in production.
WEB_DATABASE_URL=postgresql://slgs_web:replace-me@localhost:5432/slgs
CMS_DATABASE_URL=postgresql://slgs_cms:replace-me@localhost:5432/slgs
SIMS_DATABASE_URL=postgresql://slgs_sims:replace-me@localhost:5432/slgs

# Generate a high-entropy value locally. Never reuse the example text.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
CMS_BETTER_AUTH_BASE_URL=http://localhost:3001
SIMS_BETTER_AUTH_BASE_URL=http://localhost:3002
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002

# Server-only Resend credentials. The sender must belong to a verified domain.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=identity@example.invalid

# Private CMS media bucket. These credentials are server-only and should be
# restricted to this bucket. Configure browser PUT CORS for the CMS origin.
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_R2_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=slgs-cms-media
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CLOUDFLARE_R2_PRESIGNED_URL_TTL_SECONDS=300
