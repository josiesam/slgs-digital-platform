# Migration-only PostgreSQL connection. Runtime applications use their own credentials.
DATABASE_MIGRATION_URL=postgresql://slgs_migrator:replace-me@localhost:5432/slgs

# Application runtime connections must have different database grants in production.
WEB_DATABASE_URL=postgresql://slgs_web:replace-me@localhost:5432/slgs
CMS_DATABASE_URL=postgresql://slgs_cms:replace-me@localhost:5432/slgs
SIMS_DATABASE_URL=postgresql://slgs_sims:replace-me@localhost:5432/slgs

# Generate a high-entropy value locally. Never reuse the example text.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_BASE_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002

