{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "env": [
        "PUBLIC_SITE_URL",
        "DATABASE_URL",
        "WEB_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "CMS_BETTER_AUTH_BASE_URL",
        "CMS_DATABASE_URL",
        "CMS_WEB_DATABASE_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    }
  }
}