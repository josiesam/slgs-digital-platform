{
  "name": "@slgs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:fresh:generate": "drizzle-kit generate --config drizzle.fresh.config.ts --name current-schema-baseline",
    "db:fresh:migrate": "drizzle-kit migrate --config drizzle.fresh.config.ts",
    "db:verify:phase1a": "psql --set=ON_ERROR_STOP=1 \"$DATABASE_MIGRATION_URL\" --file verification/phase-1a.sql",
    "db:verify:phase1c": "psql --set=ON_ERROR_STOP=1 \"$DATABASE_MIGRATION_URL\" --file verification/phase-1c.sql",
    "db:verify:phase1d": "psql --set=ON_ERROR_STOP=1 \"$DATABASE_MIGRATION_URL\" --file verification/phase-1d.sql",
    "db:verify:scope-reset": "psql --set=ON_ERROR_STOP=1 \"$DATABASE_MIGRATION_URL\" --file verification/product-scope-reset.sql",
    "lint": "eslint src drizzle.config.ts drizzle.fresh.config.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@slgs/validation": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
